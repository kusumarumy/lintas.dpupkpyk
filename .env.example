# Generate a long random value, minimum 32 characters.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Two accounts; store bcrypt hashes, never plaintext passwords.
AUTH_USERS_JSON=[{"username":"operator1","passwordHash":"$2b$12$REPLACE_WITH_BCRYPT_HASH_1"},{"username":"operator2","passwordHash":"$2b$12$REPLACE_WITH_BCRYPT_HASH_2"}]

# Existing Cloudflare Worker public endpoint. Set this to the exact endpoint you use.
NEXT_R2_BASE_URL=https://YOUR-WORKER-ENDPOINT.workers.dev

# Optional object keys (relative to the Worker endpoint).
R2_BRIDGES_GEOJSON_KEY=data/jembatan.geojson
R2_ADMIN_GEOJSON_KEY=data/batas_administrasi.geojson
R2_ROADS_GEOJSON_KEY=data/jalan.geojson

# Cesium Ion token (server-side env; sent to browser only when serving the Cesium pages).
# Rotate the token that was embedded in the old PHP source before deployment.
CESIUM_ION_TOKEN=replace-with-a-new-restricted-cesium-ion-token
